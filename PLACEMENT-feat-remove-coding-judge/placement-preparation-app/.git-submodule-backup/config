[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	ignorecase = true
[remote "origin"]
	url = https://github.com/Loganath-dev/PLACEMENT.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[http]
	postBuffer = 524288000
[branch "feat/remove-coding-judge"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/feat/remove-coding-judge
